{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#36} wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#36}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#36} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#35}󰂄 battery {#keys}│",
            "type": "command",
            "shell": "/bin/sh",
            "text": "B=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null|head -n1); [ -n \"$B\" ] || { printf 'No battery'; exit; }; s=$(cat \"$B/status\" 2>/dev/null); p=$(cat \"$B/capacity\" 2>/dev/null); if [ -r \"$B/power_now\" ]; then uw=$(cat \"$B/power_now\"); else uw=$(awk -v c=\"$(cat \"$B/current_now\" 2>/dev/null)\" -v v=\"$(cat \"$B/voltage_now\" 2>/dev/null)\" 'BEGIN{printf \"%.0f\", c*v/1000000}'); fi; case \"$s\" in Charging) sign=\"+\";; Discharging) sign=\"-\";; *) sign=\"\";; esac; w=$(awk -v u=\"$uw\" -v g=\"$sign\" 'BEGIN{if(u<0)u=-u; if(u==0)g=\"\"; printf \"%s%.1f\", g, u/1000000}'); printf '%s W | %s%% | %s' \"$w\" \"${p:-?}\" \"${s:-Unknown}\"",
            "format": "{1}"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
